# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
*.pyo
.venv/

# R
.Rhistory
.RData
.Rproj.user/

# Mac
.DS_Store

# Claude Code local state
.claude/scheduled_tasks.lock

# Data: API caches and derived files are regenerated by the pipeline.
# data/hand_coded/ (human race coding, crosswalks) IS tracked.
data/raw/
data/datasets/
data/archive/

# Person-level race statements classified from Wikipedia text (names + race).
# Kept local only: the race-coding protocol forbids publishing person-level
# race codes. scripts/04e_predict_race.py reads them for the documented
# (preddoc) variant and the validation; the primary predicted measure does
# not depend on them. Back them up outside the repository.
data/derived/

# Stata companions are regenerated from the tracked CSV result manifests.
output/estimates/*.dta
